{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "walk.savingourmen.com"
        }
      ],
      "destination": "/cancer-walk"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
